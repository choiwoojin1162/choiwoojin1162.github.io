---
import 'katex/dist/katex.min.css';
import '../styles/editorial.css';
import {
  siteConfig,
  teacherTimeline,
  proofCases,
  reviews,
  kakaoShowcase,
  curriculumSteps,
  shortCourseTracks,
  tuitionRows,
  operationNotes,
} from '../data/site';
import { renderMath } from '../utils/math';
import MathFlowDiagram from '../components/MathFlowDiagram.astro';
import RemoteSetupDiagram from '../components/RemoteSetupDiagram.astro';

const base = import.meta.env.BASE_URL.replace(/\/$/, '');
const homeHref = base || '/';
const booksHref = `${base}/books`;
const faviconHref = `${base}/favicon.svg`;
const kimstudyCardHref = `${base}/images/kimstudy-card.jpg`;

const kimstudyProfileUrl =
  'https://kimstudy.com/tutor/s/5bb888b9-b1a1-4cc0-98eb-6cdac0f45fcd?O3WRXJQK9E=B8882AQA1';
const hasOpenChat = siteConfig.contact.kakaoOpenChatUrl.trim().length > 0;

const mathN = renderMath('n');
const mathNMinus1 = renderMath('n - 1');

const jsonLd = {
  '@context': 'https://schema.org',
  '@type': 'EducationalOrganization',
  name: siteConfig.brandName,
  description: siteConfig.description,
  telephone: siteConfig.contact.phone,
  email: siteConfig.contact.email,
};
---

<!doctype html>
<html lang="ko">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>{siteConfig.brandName} | 김과외 Premium Class · 비대면 1:1 수능 수학</title>
    <meta name="description" content={siteConfig.description} />
    <link rel="icon" type="image/svg+xml" href={faviconHref} />
    <link rel="preconnect" href="https://cdn.jsdelivr.net" crossorigin />
    <link
      rel="stylesheet"
      href="https://cdn.jsdelivr.net/gh/orioncactus/pretendard@v1.3.9/dist/web/variable/pretendardvariable-dynamic-subset.min.css"
    />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      rel="stylesheet"
      href="https://fonts.googleapis.com/css2?family=JetBrains+Mono:wght@400;500;600&family=Noto+Serif+KR:wght@400;600;700&display=swap"
    />
    <script type="application/ld+json" set:html={JSON.stringify(jsonLd)} />
  </head>

  <body>
    <!-- Sticky Header: Mobile Rounded-Bottom Drawer + Desktop Floating Pill Bar -->
    <header class="masthead" id="top-header">
      <div class="masthead-inner">
        <a href={homeHref} class="brand-mark">
          <span class="brand-dot" aria-hidden="true"></span>
          <span>{siteConfig.brandName}</span>
        </a>

        <nav class="desktop-nav-pill" aria-label="주요 메뉴">
          <a href="#benefits">풀이 기준</a>
          <a href="#credentials">강사 소개</a>
          <a href="#results">성과·후기</a>
          <a href="#curriculum">커리큘럼</a>
          <a href="#tuition">수업료</a>
          <a href={booksHref}>교재 안내</a>
        </nav>

        <div class="header-actions">
          <div class="desktop-cta-wrap">
            <button type="button" class="btn-primary btn-sm" data-open-consult>
              상담 요청 ↗
            </button>
          </div>

          <button type="button" class="mobile-quick-cta" data-open-consult>
            상담 요청 ↗
          </button>

          <button
            type="button"
            class="mobile-menu-btn"
            id="mobile-menu-toggle"
            aria-expanded="false"
            aria-controls="mobile-drawer"
            aria-label="전체 메뉴 열기"
          >
            <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round">
              <line x1="4" y1="7" x2="20" y2="7" class="menu-line-1" />
              <line x1="4" y1="12" x2="20" y2="12" class="menu-line-2" />
              <line x1="4" y1="17" x2="20" y2="17" class="menu-line-3" />
            </svg>
          </button>
        </div>
      </div>

      <div class="mobile-drawer" id="mobile-drawer" aria-hidden="true">
        <nav class="mobile-drawer-list" aria-label="모바일 내비게이션">
          <a href="#benefits" class="mobile-drawer-link">
            <span>문제 풀이 기준 · 수업 방식</span>
            <span class="mono">01</span>
          </a>
          <a href="#credentials" class="mobile-drawer-link">
            <span>강사 소개 · 김과외 상위 2%</span>
            <span class="mono">02</span>
          </a>
          <a href="#results" class="mobile-drawer-link">
            <span>수강 성과 · 인증 후기 8건</span>
            <span class="mono">03</span>
          </a>
          <a href="#curriculum" class="mobile-drawer-link">
            <span>커리큘럼 · 120분 수업 구성</span>
            <span class="mono">04</span>
          </a>
          <a href="#tuition" class="mobile-drawer-link">
            <span>수업료 · 환불 규정</span>
            <span class="mono">05</span>
          </a>
          <a href={booksHref} class="mobile-drawer-link">
            <span>자체 교재 안내 (무료 제공)</span>
            <span class="mono">BOOK ↗</span>
          </a>
        </nav>

        <div class="mobile-drawer-actions">
          <button type="button" class="btn-primary" data-open-consult>상담 요청 ↗</button>
          <a href={kimstudyProfileUrl} target="_blank" rel="noopener noreferrer" class="btn-secondary">
            김과외 프로필 ↗
          </a>
        </div>
      </div>
    </header>

    <main>
      <!-- HERO SECTION (Modern Product Launch Signature) -->
      <section class="mpl-hero">
        <div class="shell">
          <div class="mpl-eyebrow">
            김과외 Premium Class · 전국 상위 2% 이내 · 비대면 1:1 수능 수학
          </div>

          <h1 class="mpl-hero-title">
            공부량을 늘리기 전에<br />
            문제 보는 순서부터 바꿉니다.
          </h1>

          <p class="mpl-hero-lead">
            공부를 열심히 해도 3–5등급에 머무는 이유는 머리가 아니라 문제 접근 순서 때문입니다.
            한양대 기계공학부 25학번·수리논술 최초합 최우진이 비대면 실시간 동시 필기로 생각의 순서를 교정합니다.
          </p>

          <div class="mpl-hero-actions">
            <button type="button" class="btn-primary" data-open-consult>
              1:1 상담 요청 ↗
            </button>
            <a href={booksHref} class="btn-secondary">
              자체 교재 안내
            </a>
            <a
              href={kimstudyProfileUrl}
              target="_blank"
              rel="noopener noreferrer"
              class="btn-outline"
            >
              김과외 인증 후기 ↗
            </a>
          </div>

          <!-- Signature Muted Sage Backdrop (#8E9C78) with Mobile Portrait / Desktop Landscape Showcase -->
          <div class="sage-stage" aria-label="실전 성적 상승 요약 리포트">
            <div class="device-frame">
              <div class="device-notch" aria-hidden="true"></div>
              <div class="device-screen">
                <div class="screen-top-row">
                  <span class="screen-pill">VERIFIED COACHING REPORT</span>
                  <span class="mono" style="font-size: 0.72rem; color: var(--color-muted-foreground);">
                    구글 미트 + 굿노트 실시간 동시 편집
                  </span>
                </div>

                <div class="screen-metric-grid">
                  <div>
                    <div class="screen-big-stat tabular">74 → 91</div>
                    <p class="screen-big-caption">
                      수업 8회 만에 백분위 +17%p 도약 (고3 문과 수강생)
                    </p>
                  </div>

                  <div class="screen-mini-cards">
                    <div class="screen-mini-card">
                      <small>CASE 01 · 수업 4회</small>
                      <strong>6모 확통 23~30번 전원 정답</strong>
                    </div>
                    <div class="screen-mini-card">
                      <small>CASE 02 · 내신 2개월</small>
                      <strong>전교 70등 → 35등 (1등급 목전)</strong>
                    </div>
                    <div class="screen-mini-card">
                      <small>KIMSTUDY VERIFIED</small>
                      <strong>인증 리뷰 8건 전원 5.0 ★</strong>
                    </div>
                    <div class="screen-mini-card">
                      <small>TEXTBOOK INCLUDED</small>
                      <strong>5단계 기출 해설서 무료 제공</strong>
                    </div>
                  </div>
                </div>

                <div class="screen-steps-bar" aria-label="3단계 행동 강령 요약">
                  <div class="screen-step-chip">01 목적 파악</div>
                  <div class="screen-step-chip">02 조건 분해</div>
                  <div class="screen-step-chip">03 n−1 공식 선택</div>
                </div>
              </div>
            </div>
          </div>
        </div>
      </section>

      <!-- TRUSTED BY / CREDENTIAL STRIP -->
      <section class="trust-strip" aria-label="핵심 신뢰 지표">
        <div class="shell">
          <div class="trust-label">VERIFIED CREDENTIALS &amp; REPUTATION</div>
          <div class="trust-logos">
            <div class="trust-item">
              <strong>김과외 Premium Class</strong>
              <span>전국 상위 2% 이내 선정</span>
            </div>
            <div class="trust-item">
              <strong>한양대 기계공학부 25학번</strong>
              <span>서울 본교 · 수리논술 최초합</span>
            </div>
            <div class="trust-item">
              <strong>인증 리뷰 8건 5.0 / 5.0</strong>
              <span>성사 대비 등록률 80% · 37.5℃</span>
            </div>
            <div class="trust-item">
              <strong>전 과정 비대면 1:1</strong>
              <span>예비 고2 · 고2 · 고3 · N수생</span>
            </div>
          </div>
        </div>
      </section>

      <!-- SECTION 01: BENEFITS & SOLVING SYSTEM -->
      <section class="section-block" id="benefits">
        <div class="shell">
          <span class="section-index">01 / BENEFITS · 문제 풀이 기준</span>
          <h2 class="section-title">
            양을 늘리기 전에 고쳐야 할<br />
            3단계 생각의 순서와 교정 방식
          </h2>
          <p class="section-intro">
            풀이 과정을 머리로 암기하는 학생은 조건이 조금만 바뀌어도 손이 멈춥니다.
            무작정 문제를 많이 풀기 전에 목적을 먼저 확인하고 조건으로 공식을 선택하는 기준부터 세웁니다.
          </p>

          <div class="benefits-grid">
            <article class="benefit-card">
              <svg class="benefit-icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                <circle cx="12" cy="12" r="9" />
                <circle cx="12" cy="12" r="3" />
              </svg>
              <h3>① 목적 파악 먼저</h3>
              <p>풀이 첫 줄을 쓰기 전에 문제에서 최종적으로 요구하는 끝점 1개를 먼저 확정합니다.</p>
            </article>

            <article class="benefit-card">
              <svg class="benefit-icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                <rect x="3" y="4" width="7" height="7" rx="1.5" />
                <rect x="14" y="4" width="7" height="7" rx="1.5" />
                <rect x="8.5" y="14" width="7" height="7" rx="1.5" />
              </svg>
              <h3>② 조건·미지수 분리</h3>
              <p>주어진 조건을 있는 그대로 분해해 상수와 미지수를 구분하고 식의 재료를 정리합니다.</p>
            </article>

            <article class="benefit-card">
              <svg class="benefit-icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                <path d="M5 17L10 12L14 15L19 7" />
                <path d="M15 7H19V11" />
              </svg>
              <h3>③ <span set:html={mathN} />개 중 <span set:html={mathNMinus1} />개 공식</h3>
              <p>
                미지수 <span set:html={mathN} />개 식 중 조건으로 <span set:html={mathNMinus1} />개가 채워진 공식을 고르면 남은 1개가 곧바로 답이 됩니다.
              </p>
            </article>

            <article class="benefit-card">
              <svg class="benefit-icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                <rect x="3" y="4" width="18" height="13" rx="2.5" />
                <path d="M8 20H16" />
                <path d="M12 17V20" />
              </svg>
              <h3>④ 2기기 실시간 동시 필기</h3>
              <p>핸드폰(구글 미트)과 패드 1대(굿노트 공유 파일)로 푸는 중간에 바로 개입해 잘못된 습관을 끊습니다.</p>
            </article>
          </div>

          <div class="mistakes-strip" aria-label="점수를 깎는 3가지 실수 원인">
            <div class="mistake-item">
              <strong>실수 원인 ① 연습 부족 (인지 부하)</strong>
              <span>문제 풀이에 에너지를 다 써서 사소한 부호·연산 검토 여력이 남지 않는 상태</span>
            </div>
            <div class="mistake-item">
              <strong>실수 원인 ② 검토·시간 배분 부재</strong>
              <span>시험장에서 다시 점검할 지점과 넘어갈 문항 기준이 정해져 있지 않은 상태</span>
            </div>
            <div class="mistake-item">
              <strong>실수 원인 ③ 안 좋은 습관</strong>
              <span>암산 생략, 불명확한 글씨, 조건 누락 등 매 시험 감점을 부르는 개인 습관 교정</span>
            </div>
          </div>

          <div class="diagram-stack">
            <MathFlowDiagram />
            <RemoteSetupDiagram />
          </div>
        </div>
      </section>

      <!-- SECTION 02: SEE THE BIG PICTURE (CREDENTIALS & KIMSTUDY CARD) -->
      <section class="section-block" id="credentials">
        <div class="shell">
          <div class="split-feature">
            <div>
              <span class="section-index">02 / CREDENTIALS · 강사 소개</span>
              <h2 class="section-title">
                4등급에서 백분위 98까지,<br />
                직접 검증한 공부 기준
              </h2>
              <p class="section-intro">
                한양대학교(서울 본교) 기계공학부 25학번 · 수리논술 최초합 최우진.
                타고난 천재여서가 아니라, 정석 30회독에도 4등급에 머물던 막막함을 '조건·개념·목적의 연결 기준'으로 직접 뚫어낸 경험을 바탕으로 가르칩니다.
              </p>

              <div class="numbered-rows">
                {
                  teacherTimeline.map((item, idx) => (
                    <div class="numbered-row">
                      <span class="row-num">0{idx + 1}</span>
                      <div class="row-content">
                        <span class="row-tag">{item.tag}</span>
                        <strong>{item.title}</strong>
                        <p>{item.body}</p>
                      </div>
                    </div>
                  ))
                }
              </div>

              <a
                href={kimstudyProfileUrl}
                target="_blank"
                rel="noopener noreferrer"
                class="btn-secondary"
              >
                김과외 공식 프로필 확인하기 ↗
              </a>
            </div>

            <aside class="credential-visual-card">
              <div class="kimstudy-badge-pill">
                김과외 Premium Class 선생님 · 전국 상위 2% 이내
              </div>

              <div class="card-photo-frame">
                <img
                  src={kimstudyCardHref}
                  alt="최우진 강사 김과외 Premium Class 전국 상위 2% 이내 명함"
                  loading="lazy"
                />
              </div>

              <blockquote class="editorial-quote">
                “군 복무 등으로 2년 넘게 수능 공부를 쉬고도 2025 수능에서 교재 3~4권·실전 모의고사 약 10개만으로 미적분 백분위 98과 한양대 수리논술 최초 합격을 만들었습니다. 양이 아니라 기준입니다.”
                <footer>— {siteConfig.affiliation}</footer>
              </blockquote>
            </aside>
          </div>
        </div>
      </section>

      <!-- SECTION 03: PROOF CASES, UNIFIED 8 REVIEWS & KAKAOTALK SHOWCASE -->
      <section class="section-block" id="results">
        <div class="shell">
          <span class="section-index">03 / PROOF &amp; REVIEWS · 수강 성과</span>
          <h2 class="section-title">
            단기간 변화를 만든<br />
            실제 수강 사례와 인증 후기 8건
          </h2>
          <p class="section-intro">
            김과외 정규 성사 10건(외부 경력 5건 별도), 성사 대비 80% 리뷰 등록률, 8건 전원 5.0 만점·김과외 평판 온도 37.5℃의 실제 기록입니다.
          </p>

          <!-- Featured Quote + Metrics -->
          <div class="featured-testimonial">
            <div>
              <blockquote>
                “중학교 때부터 5년 넘게 학원을 다녔는데도 맨날 6등급 언저리였어요. 딱 4번 수업하면서 그 버릇이 고쳐졌고, 학원에서 손도 못 대던 확률과 통계 4점짜리를 제 힘으로 풀었습니다.”
              </blockquote>
              <div class="quote-meta">
                이브이86560 · 서울 고3 문과 학생 · 김과외 인증 후기 5.0 ★
              </div>
            </div>

            <div class="mini-metrics-2x2">
              <div class="mini-metric-box">
                <strong class="tabular">10건</strong>
                <span>김과외 정규 성사<br />(외부 경력 5건 별도)</span>
              </div>
              <div class="mini-metric-box">
                <strong class="tabular">5.0 / 5.0</strong>
                <span>인증 리뷰 8건<br />전 항목 만점</span>
              </div>
              <div class="mini-metric-box">
                <strong class="tabular">37.5℃</strong>
                <span>김과외 평판 온도</span>
              </div>
              <div class="mini-metric-box">
                <strong class="tabular">상위 2%</strong>
                <span>김과외 Premium Class<br />공식 선정 강사</span>
              </div>
            </div>
          </div>

          <!-- 4 Proof Cases -->
          <div class="cases-grid">
            {
              proofCases.map((c) => (
                <article class="case-card">
                  <div class="case-top">
                    <span class="case-badge">CASE {c.id} · {c.period}</span>
                    <span style="font-size: 0.78rem; font-weight: 600; color: var(--color-muted-foreground);">
                      {c.student}
                    </span>
                  </div>
                  <p class="case-before">Before: {c.before}</p>
                  <p class="case-after">After: {c.after}</p>
                </article>
              ))
            }
          </div>

          <!-- Unified 8 Kimstudy Verified Reviews Container -->
          <div class="reviews-panel">
            <div class="reviews-panel-head">
              <strong>김과외 인증 리뷰 전문 (총 {reviews.length}건 · 전원 5.0 만점)</strong>
              <span class="mono" style="font-size: 0.74rem; color: var(--color-accent-mono);">
                VERIFIED BY KIMSTUDY
              </span>
            </div>

            <div id="reviews-list">
              {
                reviews.map((rev, idx) => (
                  <article class={`review-item ${idx >= 3 ? 'is-hidden' : ''}`} data-extra-review={idx >= 3 ? 'true' : undefined}>
                    <div class="review-meta-row">
                      <span class="review-author">{rev.author}</span>
                      <span class="review-badge">★ {rev.score} · {rev.meta}</span>
                    </div>
                    <p class="review-body">{rev.content}</p>
                  </article>
                ))
              }
            </div>

            <div class="reviews-toggle-bar">
              <button
                type="button"
                id="toggle-reviews-btn"
                class="btn-outline btn-sm"
                aria-expanded="false"
              >
                인증 후기 5건 더 보기 (총 8건 전체) ↓
              </button>
            </div>
          </div>

          <!-- Horizontal-swipe on Mobile KakaoTalk Real Feedback -->
          <div style="margin-bottom: 12px; display: flex; align-items: baseline; justify-content: space-between; gap: 12px;">
            <strong style="font-size: 0.96rem;">수강생·학부모 실제 카카오톡 감사 메시지 요약</strong>
            <span class="mono" style="font-size: 0.72rem; color: var(--color-muted-foreground);">SWIPE ON MOBILE →</span>
          </div>

          <div class="kakao-rail" aria-label="실제 카카오톡 대화 요약 갤러리">
            {
              kakaoShowcase.map((talk) => (
                <article class="kakao-card">
                  <div class="kakao-card-top">
                    <span>{talk.sender}</span>
                    <span class="mono" style="font-size: 0.7rem;">{talk.tag}</span>
                  </div>
                  <p>{talk.message}</p>
                </article>
              ))
            }
          </div>
        </div>
      </section>

      <!-- SECTION 04: MAP YOUR SUCCESS (CURRICULUM & 120-MIN FLOW) -->
      <section class="section-block" id="curriculum">
        <div class="shell">
          <div style="display: flex; flex-wrap: wrap; align-items: flex-end; justify-content: space-between; gap: 16px; margin-bottom: 24px;">
            <div>
              <span class="section-index">04 / MAP YOUR SUCCESS · 커리큘럼</span>
              <h2 class="section-title" style="margin-bottom: 0;">4단계 커리큘럼과 120분 수업 흐름</h2>
            </div>
            <a href={booksHref} class="btn-secondary btn-sm">
              자체 5단계 해설서 자세히 보기 →
            </a>
          </div>

          <div class="map-steps-grid">
            {
              curriculumSteps.map((st) => (
                <article class="map-step-card">
                  <div class="map-step-num tabular">{st.step}</div>
                  <h3>{st.title}</h3>
                  <span class="map-step-book">{st.book}</span>
                  <p>{st.detail}</p>
                </article>
              ))
            }
          </div>

          <!-- Compact Short Course Tracks in clean prose (not nested boxes/tables) -->
          <div class="short-course-prose">
            <h3>단원별 단기 특강 선택 범위 (9개 소단원 집중 보완)</h3>
            <p>
              약점 단원만 빠르게 잡는 2–4회 집중 과정은{' '}
              {shortCourseTracks.map((tr, idx) => (
                <>
                  <strong>{tr.subject}</strong>({tr.units.join(' · ')})
                  {idx < shortCourseTracks.length - 1 ? ' / ' : ''}
                </>
              ))}
              {' '}총 9개 소단원 중 원하는 파트를 선택해 신청할 수 있습니다.
            </p>
          </div>

          <!-- 120-minute Lesson Structure -->
          <div class="lesson-bar-wrap">
            <div class="lesson-bar-head">
              <span>정규 1회 120분 표준 수업 배분</span>
              <span class="mono" style="color: var(--color-accent);">10 + 50 + 50 + 10 MIN</span>
            </div>
            <div class="lesson-bar">
              <div class="lesson-seg lesson-seg--light">
                10분<br />숙제 점검
              </div>
              <div class="lesson-seg lesson-seg--olive">
                50분 · 핵심 개념 설명 및 풀이 시범 (목적·조건 기준 정립)
              </div>
              <div class="lesson-seg lesson-seg--lime">
                50분 · 학생 실시간 손풀이 피드백 (사고 정체 구간 즉시 개입)
              </div>
              <div class="lesson-seg lesson-seg--light">
                10분<br />과제 정리
              </div>
            </div>
          </div>
        </div>
      </section>

      <!-- SECTION 05: TUITION, SPECS & REFUND RULES -->
      <section class="section-block section-block--last" id="tuition">
        <div class="shell">
          <span class="section-index">05 / TUITION &amp; RULES · 수업료 및 운영 원칙</span>
          <h2 class="section-title">투명한 수강 안내와 환불 기준</h2>
          <p class="section-intro">
            시범 과외(1시간)로 학생의 현재 풀이 습관과 수업 적합성을 먼저 확인한 뒤,
            정규 수업·단원별 단기 특강을 결정하실 수 있습니다.
          </p>

          <div class="tuition-grid">
            {
              tuitionRows.map((row) => (
                <article class={`tuition-card ${row.name === '수학 정규 1:1' ? 'tuition-card--featured' : ''}`}>
                  <div>
                    <div class="tuition-name">
                      <span>{row.name}</span>
                      {row.name === '수학 정규 1:1' && (
                        <span class="screen-pill">추천</span>
                      )}
                    </div>
                    <div class="tuition-unit">{row.unit}</div>
                    <div class="tuition-price tabular" style="margin: 10px 0 8px;">{row.price}</div>
                    <p class="tuition-target">{row.target}</p>
                  </div>
                  <div class="tuition-note">{row.note}</div>
                </article>
              ))
            }
          </div>

          <div class="ledger-box" aria-label="수업 운영 세부 기준">
            {
              operationNotes.map((item) => (
                <div class="ledger-row">
                  <span class="ledger-key">{item.key}</span>
                  <span class="ledger-val">{item.value}</span>
                </div>
              ))
            }
          </div>

          <div class="refund-notice" role="note" aria-label="환불 및 준비물 안내">
            <strong>수업 변경·환불 및 준비물 안내:</strong>{' '}
            수업 전날 밤 10시(22:00)까지 말씀 시 당일 회차 100% 환불해 드리며, 시범 과외(30,000원)는 정규 등록 시 전액 환급됩니다.
            정규·단기 수강 시 「아이패드 + 굿노트 에센셜」 별도 구매가 필요하며(시범 과외는 불필요), 태블릿(아이패드)·굿노트 앱 구매 비용은 별도 환불이 불가합니다.
          </div>
        </div>
      </section>

      <!-- CONNECT WITH US CTA -->
      <section class="connect-band">
        <div class="shell">
          <h2 class="connect-title">상담 요청하기</h2>
          <p class="connect-sub">
            현재 모의고사·내신 등급과 고민되는 단원을 편하게 알려주세요.
            확인 즉시 가장 적합한 수업 방향을 안내해 드립니다. ({siteConfig.contact.consultHours})
          </p>
          <div class="mpl-hero-actions" style="margin-bottom: 0;">
            <button type="button" class="btn-primary" data-open-consult>
              지금 상담 요청 ↗
            </button>
            <a href={booksHref} class="btn-secondary">
              자체 교재 안내 보기
            </a>
          </div>
        </div>
      </section>
    </main>

    <!-- FOOTER -->
    <footer class="footer">
      <div class="shell">
        <div class="footer-grid">
          <div>
            <h2 class="footer-title">{siteConfig.brandName}</h2>
            <p class="footer-desc">
              {siteConfig.affiliation} · 김과외 Premium Class 전국 상위 2% 이내 · {siteConfig.contact.mode}
            </p>
            <div style="display: flex; flex-wrap: wrap; gap: 8px;">
              <button type="button" class="btn-primary btn-sm" data-open-consult>
                상담 요청 ↗
              </button>
              <a href={booksHref} class="btn-outline btn-sm">
                교재 안내
              </a>
            </div>
          </div>

          <div>
            <div class="footer-meta-row">
              <span class="footer-meta-key">전화 · 문자</span>
              <span class="footer-meta-val tabular">
                <a href={`tel:${siteConfig.contact.phone}`}>{siteConfig.contact.phone}</a>
              </span>
            </div>
            <div class="footer-meta-row">
              <span class="footer-meta-key">카카오톡 ID</span>
              <span class="footer-meta-val">{siteConfig.contact.kakaoId}</span>
            </div>
            <div class="footer-meta-row">
              <span class="footer-meta-key">이메일</span>
              <span class="footer-meta-val">{siteConfig.contact.email}</span>
            </div>
            <div class="footer-meta-row">
              <span class="footer-meta-key">수업 시간</span>
              <span class="footer-meta-val">{siteConfig.contact.lessonHours}</span>
            </div>
            <div class="footer-meta-row">
              <span class="footer-meta-key">상담 시간</span>
              <span class="footer-meta-val">{siteConfig.contact.consultHours}</span>
            </div>
          </div>
        </div>

        <div class="footer-bottom">
          <span>© 2026 {siteConfig.brandName}. All rights reserved.</span>
          <span>KIMSTUDY PREMIUM CLASS · TOP 2%</span>
        </div>
      </div>
    </footer>

    <!-- CONSULTATION MODAL -->
    <dialog id="consult-dialog" class="consult-dialog" aria-labelledby="dialog-title">
      <div class="dialog-head">
        <strong id="dialog-title" style="font-family: var(--font-serif); font-size: 1.1rem;">상담 요청 안내</strong>
        <button type="button" class="dialog-close" data-close-consult>닫기</button>
      </div>
      <p style="font-size: 0.88rem; color: var(--color-secondary); margin: 0 0 14px;">
        편하신 채널로 연락 주시면 확인 후 바로 답변드립니다. ({siteConfig.contact.consultHours})
      </p>
      {
        hasOpenChat && (
          <a
            href={siteConfig.contact.kakaoOpenChatUrl}
            target="_blank"
            rel="noopener noreferrer"
            class="btn-primary"
            style="width: 100%; margin-bottom: 14px;"
          >
            카카오톡 오픈채팅 바로 가기 ↗
          </a>
        )
      }
      <div class="ledger-box" style="margin-top: 0; margin-bottom: 14px;">
        <div class="ledger-row" style="grid-template-columns: 92px 1fr;">
          <span class="ledger-key">카톡 ID</span>
          <span class="ledger-val"><strong>{siteConfig.contact.kakaoId}</strong></span>
        </div>
        <div class="ledger-row" style="grid-template-columns: 92px 1fr;">
          <span class="ledger-key">전화 · 문자</span>
          <span class="ledger-val tabular">{siteConfig.contact.phone}</span>
        </div>
        <div class="ledger-row" style="grid-template-columns: 92px 1fr;">
          <span class="ledger-key">이메일</span>
          <span class="ledger-val">{siteConfig.contact.email}</span>
        </div>
      </div>
      <div style="display: grid; grid-template-columns: 1fr 1fr; gap: 8px;">
        <a href={`sms:${siteConfig.contact.phone}`} class="btn-secondary">문자 보내기</a>
        <a href={`tel:${siteConfig.contact.phone}`} class="btn-outline">바로 전화하기</a>
      </div>
    </dialog>

    <script>
      // Mobile Hamburger Drawer Toggle
      const menuBtn = document.getElementById('mobile-menu-toggle');
      const drawer = document.getElementById('mobile-drawer');

      function setDrawer(open: boolean) {
        if (!menuBtn || !drawer) return;
        drawer.classList.toggle('is-open', open);
        drawer.setAttribute('aria-hidden', open ? 'false' : 'true');
        menuBtn.setAttribute('aria-expanded', open ? 'true' : 'false');
        menuBtn.setAttribute('aria-label', open ? '메뉴 닫기' : '전체 메뉴 열기');
      }

      menuBtn?.addEventListener('click', () => {
        const isOpen = drawer?.classList.contains('is-open') ?? false;
        setDrawer(!isOpen);
      });

      drawer?.querySelectorAll('a, button').forEach((item) => {
        item.addEventListener('click', () => setDrawer(false));
      });

      // Unified 8 Reviews Toggle
      const toggleBtn = document.getElementById('toggle-reviews-btn');
      const extraReviews = document.querySelectorAll('[data-extra-review="true"]');
      let reviewsExpanded = false;

      toggleBtn?.addEventListener('click', () => {
        reviewsExpanded = !reviewsExpanded;
        extraReviews.forEach((el) => {
          el.classList.toggle('is-hidden', !reviewsExpanded);
        });
        toggleBtn.setAttribute('aria-expanded', reviewsExpanded ? 'true' : 'false');
        toggleBtn.textContent = reviewsExpanded
          ? '인증 후기 접기 ↑'
          : '인증 후기 5건 더 보기 (총 8건 전체) ↓';
      });

      // Consult Dialog
      const dialog = document.getElementById('consult-dialog') as HTMLDialogElement | null;
      document.querySelectorAll('[data-open-consult]').forEach((el) => {
        el.addEventListener('click', (e) => {
          if (dialog) {
            e.preventDefault();
            dialog.showModal();
          }
        });
      });
      document.querySelectorAll('[data-close-consult]').forEach((el) => {
        el.addEventListener('click', () => dialog?.close());
      });
      dialog?.addEventListener('click', (e) => {
        if (e.target === dialog) dialog.close();
      });
    </script>
  </body>
</html>
